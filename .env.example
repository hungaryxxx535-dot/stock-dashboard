# Optional market providers. Empty values must degrade safely.
TUSHARE_TOKEN=
FRED_API_KEY=
TWELVE_DATA_API_KEY=
AKSHARE_API_URL=
AKSHARE_SERVICE_TOKEN=

# Optional protected Vercel Cron endpoint.
CRON_SECRET=

# Optional cloud sync adapter. Local IndexedDB remains the default.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Hermes quant core. All schedulers and gated pushes default to disabled.
HERMES_DB_PATH=.local-private/hermes_quant.db
HERMES_CACHE_DIR=.local-private/cache
HERMES_HTTP_PROXY=
HERMES_REQUEST_TIMEOUT_SECONDS=20
HERMES_REQUEST_RATE_PER_SECOND=1
HERMES_MAX_RETRIES=3
HERMES_EXECUTION_MODE=paper
HERMES_SCHEDULER_ENABLED=false
HERMES_0800_PUSH_ENABLED=false
HERMES_0925_PUSH_ENABLED=false
# Generate a local random secret; never commit the real value.
HERMES_QUANT_API_TOKEN=
HERMES_QUANT_API_HOST=127.0.0.1
HERMES_QUANT_API_PORT=8765
HERMES_QUANT_API_RATE_LIMIT_PER_MINUTE=120
FEISHU_WEBHOOK_URL=
